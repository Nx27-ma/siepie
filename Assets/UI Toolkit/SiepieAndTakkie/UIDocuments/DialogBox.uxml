<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Body" style="flex-grow: 1; align-items: flex-end; justify-content: center; width: 100%; height: 100%;">
        <ui:VisualElement name="Wrap" style="flex-grow: 1; width: 80%; margin-bottom: 3%; margin-right: auto; margin-left: auto;">
            <ui:VisualElement name="Expression" style="flex-grow: 1; -unity-background-scale-mode: scale-to-fit;" />
            <ui:VisualElement name="Dialog" style="flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
